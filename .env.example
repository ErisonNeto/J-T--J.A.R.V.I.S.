# Use backend/.env when running from backend/. Never commit this file with real secrets.
APP_ENV=development
MEMORY_DATABASE_URL=sqlite:///./jarvis-dev.sqlite3
# PostgreSQL in production, two independent roles on the same local database:
# MEMORY_DATABASE_URL=postgresql+psycopg://jarvis_memory:PASSWORD@127.0.0.1:5432/jt_indicadores
OPERATIONAL_DATABASE_URL=
REGIONAL_NAME=ORLEAN DA SILVA DO NASCIMENTO
# Enable only after schema discovery, reviewed historical assignments, and dashboard parity checks.
APPROVED_INDICATORS=
REQUESTS_PER_MINUTE=30
RETENTION_DAYS=365
# Disabled by default. Authorization must cover messages, aggregates and retrieved memories.
ALLOW_EXTERNAL_AI=false
ALLOW_EXTERNAL_SEARCH=false
OPENAI_API_KEY=
# Model ID available to your API project. No hardcoded promise of access or cost.
OPENAI_MODEL=
# Local direct development: leave empty. Production core and gateway: same random secret (32+ chars).
BRIDGE_TOKEN=
# Render gateway only (HTTPS tunnel to local core, never PostgreSQL):
PREDATOR_API_URL=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
